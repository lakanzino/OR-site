# خروجی‌های ساخته‌شده و فایل‌های موقت — سورس و اسناد در مخزن می‌مانند
*.zip
!releases/*.zip
!releases/article-packages/*.zip
!themes/lax-theme-child/content-imports/*.zip
.DS_Store
Thumbs.db
*.log

# پایتون — فایل‌های کامپایل‌شده هرگز نباید کامیت شوند
__pycache__/
*.pyc

# جاوااسکریپت — وابستگی‌های نصب‌شده هرگز نباید کامیت شوند
node_modules/
node_modules

# پوشهٔ موقت دانلود از Google Drive (کپی نهایی در docs/ می‌ماند)
google_drive/

# اندروید (اپ همیار-ج) — خروجی‌های ساخت هرگز نباید کامیت شوند
/.gradle/
/build/
/app/build/
/local.properties
/app/local.properties
/.kotlin/
/.idea/
*.iml
/captures
.cxx
/externalNativeBuild/
*.apk
*.aab
gradle-output.log
