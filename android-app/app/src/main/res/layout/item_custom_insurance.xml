<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:gravity="center_vertical" android:background="@color/blue_50" android:padding="8dp" android:layout_marginBottom="6dp" android:layoutDirection="rtl">
    <TextView android:id="@+id/tvInsurance" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:padding="8dp" android:textColor="@color/blue_700" android:textSize="16sp" />
    <Button android:id="@+id/btnDelete" style="@style/ClinicWarningButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/delete" />
</LinearLayout>
