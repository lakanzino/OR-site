<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared look for table cells (width 0dp + weight = equal-ish columns) -->
    <style name="HeaderCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textColor">@color/blue_700</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RowCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ClinicTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="errorTextColor">@color/amber_text</item>
    </style>
    <style name="ClinicSaveButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/green_success</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="ClinicWarningButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/amber_text</item>
        <item name="strokeColor">@color/amber_action</item>
    </style>
</resources>
